/vendor/

# Go workspace file
go.work

# Go build cache
/go-build/

# IDE/editor configs
.vscode/
.idea/
*.swp
*~
.DS_Store

# Environment files
.env
.env.*

# Database
*.db
*.sqlite
*.sqlite3

# Keys and secrets
private_key.pem
public_key.pem
private_key_base64.txt
public_key_base64.txt

# Logs
*.log
logs/

# Coverage reports
coverage.out

# Test output
*.test

# OS generated files
Thumbs.db
Desktop.ini

# Migration generated files
migrations/*.lock

# Node/npm (if any frontend or scripts)
node_modules/

# Python (if any scripts)
__pycache__/
*.pyc

# Misc
*.bak 